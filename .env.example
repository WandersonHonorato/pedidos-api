# Copie para .env:  cp .env.example .env
# O .env NÃO vai para o Git (.gitignore). Troque a senha em qualquer ambiente real.

# Porta exposta no host pelo docker compose
API_PORT=3000
LOG_LEVEL=info

# Banco usado pelo docker compose
POSTGRES_USER=pedidos
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=pedidos

# Só para rodar a API fora do Docker (npm start):
#   memory   -> sem banco, dados somem ao reiniciar
#   postgres -> exige DATABASE_URL
REPOSITORY=memory
# DATABASE_URL=postgres://pedidos:troque-esta-senha@localhost:5432/pedidos
PORT=3000
